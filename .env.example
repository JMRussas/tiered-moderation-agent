# T1 -- local LLM tier. Everything has a working default; nothing is required.
T1_MODEL=ollama:qwen3.5
OLLAMA_URL=http://127.0.0.1:11434
T1_NUM_CTX=8192
T1_CONCURRENCY=4
T1_TIMEOUT_S=30

# Point at a real, private blocklist in deployment. The committed
# src/tiermod/blocklist.json holds synthetic placeholder tokens only.
# BLOCKLIST_PATH=data/blocklist.local.json

# Optional: traces for the T1/T2 calls.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=tiered-moderation-agent
